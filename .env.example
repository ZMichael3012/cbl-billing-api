# Local environment variables for cbl-billing-api.
HTTP_ADDR=:8010
METRICS_ADDR=:9210
PG_DSN=postgres://cbl:cbl@localhost:5432/billing?sslmode=disable
REDIS_ADDR=localhost:6379
MIGRATIONS_DIR=./migrations

# Merchant API keys (7.2); invalid values cause a startup failure.
API_KEY_ROTATION_GRACE=24h
API_KEY_CACHE_TTL=5m
API_KEY_DENY_CACHE_TTL=60s

# Idempotency (7.3); invalid values cause a startup failure.
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_PROCESSING_TIMEOUT=2m
